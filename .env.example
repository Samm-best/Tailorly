NODE_ENV=development
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost
MONGODB_URI=mongodb://127.0.0.1:27017/tailorly
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Transactional email (Brevo). Required in production.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tailorly
# Development only: skip the email step and mark new accounts verified. Rejected in production.
AUTO_VERIFY_EMAIL_IN_DEV=true

# Product/logo photo uploads (Phase 5). Optional: without them everything works except image upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Checkout (Phase 7). The secret is server-only.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
REDIS_URL=
